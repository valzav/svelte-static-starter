# Header-level noindex for staging and every pages.dev host (ADR-0006).
# Cloudflare Pages reads this file from the build output.
# Replace the first host with your own staging domain; no rule may match production.
https://dev.example.com/*
  X-Robots-Tag: noindex

https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# The style guide is a working reference, not public content, so it stays out of search in every
# environment. A page-level robots meta would put one on a production page, which
# `pnpm verify:robots` forbids; a header rule keeps that assertion intact.
/styleguide*
  X-Robots-Tag: noindex
